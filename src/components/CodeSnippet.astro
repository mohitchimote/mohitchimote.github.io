---
import { Code } from 'astro:components';
import type { CodeLanguage } from 'astro';

interface Props {
  file: string;
  lang: string;
  code: string;
  repoUrl?: string;
}

const { file, lang, code, repoUrl } = Astro.props;
---
<div class="code-snippet">
  <div class="code-snippet-header">
    <span class="code-snippet-file">
      {file}
      {repoUrl && <> &middot; <a href={repoUrl} target="_blank" rel="noopener" style="color:var(--amber)">view on GitHub ↗</a></>}
    </span>
    <span class="code-snippet-lang">{lang}</span>
  </div>
  <Code code={code.trimEnd()} lang={lang as CodeLanguage} theme="github-dark" />
</div>
